<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\StationeersLuaAddonTemplate-main\Stationeers.VS.User.props" Condition="Exists('..\StationeersLuaAddonTemplate-main\Stationeers.VS.User.props')" />
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>ScriptedScreensHtml.Tests</RootNamespace>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NoWarn>$(NoWarn);CS0618;CS8618;CS8625;CA1416</NoWarn>
        <Managed>$(SteamLibraryDirectory)\Stationeers\rocketstation_Data\Managed</Managed>
    </PropertyGroup>
    <ItemGroup>
        <!-- The parsers are Unity-free on purpose so they compile here from source. -->
        <Compile Include="..\ScriptedScreensHtml\HtmlParser.cs" />
        <Compile Include="..\ScriptedScreensHtml\CssParser.cs" />
        <Compile Include="..\ScriptedScreensHtml\SceneSlots.cs" />
        <Compile Include="..\ScriptedScreensHtml\TextMeasure.cs" />
        <Compile Include="..\ScriptedScreensHtml\JsNumber.cs" />
        <Compile Include="..\ScriptedScreensHtml\JsToLua.cs" />
        <Compile Include="..\ScriptedScreensHtml\JsEngine.cs" />
        <Compile Include="..\ScriptedScreensHtml\DomWrites.cs" />
        <Compile Include="..\ScriptedScreensHtml\DomSlots.cs" />
        <Compile Include="..\ScriptedScreensHtml\CompiledPage.cs" />
        <Compile Include="..\ScriptedScreensHtml\Motion.cs" />
        <Compile Include="..\ScriptedScreensHtml\Markup.cs" />
        <!-- The CSS probe asks whether a property changes the DRAWING, which only the real cascade
             and the real emitter can answer, so it needs the Unity-bound half of the pipeline too.
             Stubs.cs is the bench's: the three mod singletons, standing in outside the game. -->
        <Compile Include="..\ScriptedScreensHtml\Yoga\**\*.cs" />
        <Compile Include="..\ScriptedScreensHtml\Dom.cs" />
        <Compile Include="..\ScriptedScreensHtml\DomStyle.cs" />
        <Compile Include="..\ScriptedScreensHtml\StyleApplier.cs" />
        <Compile Include="..\ScriptedScreensHtml\HtmlRenderer.cs" />
        <Compile Include="..\ScriptedScreensHtml\GridLayout.cs" />
        <Compile Include="..\ScriptedScreensHtml\PostLayout.cs" />
        <Compile Include="..\ScriptedScreensHtml\OffThread.cs" />
        <Compile Include="..\ScriptedScreensHtml\SvgElement.cs" />
        <Compile Include="..\ScriptedScreensHtml\CanvasElement.cs" />
        <Compile Include="..\ScriptedScreensHtml\Animation.cs" />
        <Compile Include="..\ScriptedScreensHtml\Tweens.cs" />
        <Compile Include="..\ScriptedScreensHtml\CssTransition.cs" />
        <Compile Include="..\ScriptedScreensHtml\VectorEmitter.cs" />
        <!-- The half of the compiler that needs the layout engine: a data-driven page's boxes and
             its bool states are read from the laid-out, emitted page, as a surface does it. -->
        <Compile Include="..\ScriptedScreensHtml\PageCompiler.cs" />
        <Compile Include="..\ScriptedScreensHtml\MarkupSlots.cs" />
        <!-- The data fast path: its own file stands in for the three ScriptedScreens value types it reads. -->
        <Compile Include="..\ScriptedScreensHtml\DataSlots.cs" />
        <Compile Include="..\ScriptedScreensHtml.Bench\Stubs.cs" />
        <Compile Include="CssLanguage.cs" />
        <Compile Include="CssTransitionTests.cs" />
        <Compile Include="DomLanguage.cs" />
        <Compile Include="Program.cs" />
        <Compile Include="Probe.cs" />
        <Compile Include="Probe2.cs" />
        <Compile Include="Probe3.cs" />
        <Compile Include="Probe4.cs" />
        <Compile Include="JsBench.cs" />
        <Compile Include="MotionProbe.cs" />
        <Compile Include="MotionTests.cs" />
        <Compile Include="Corpus.cs" />
        <Compile Include="Language.cs" />
        <Compile Include="ClassTests.cs" />
        <Compile Include="CssTests.cs" />
        <Compile Include="SyntaxTests.cs" />
        <Compile Include="MarkupProbe.cs" />
        <Compile Include="PreludeRuntime.cs" />
        <Compile Include="JsToLuaTests.cs" />
        <Compile Include="CompiledPageTests.cs" />
        <Compile Include="DataSlotsTests.cs" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Jint" Version="4.16.2" />
      <!-- The game's own Lua, so a transpiled page is checked on the interpreter that will run it
           rather than on a lookalike. -->
      <Reference Include="Lua">
        <HintPath>$(SteamLibraryDirectory)\..\workshop\content\544550\3659911735\Lua.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath></Reference>
      <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(Managed)\UnityEngine.UIElementsModule.dll</HintPath></Reference>
      <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath></Reference>
      <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)\Unity.TextMeshPro.dll</HintPath></Reference>
      <Reference Include="UnityEngine.TextCoreTextEngineModule"><HintPath>$(Managed)\UnityEngine.TextCoreTextEngineModule.dll</HintPath></Reference>
      <Reference Include="UnityEngine.TextCoreFontEngineModule"><HintPath>$(Managed)\UnityEngine.TextCoreFontEngineModule.dll</HintPath></Reference>
    </ItemGroup>
  <ItemGroup>
    <!-- A scene captured from the running game, so the mapping is checked against what the emitter
         really produces rather than against a hand-written approximation of it. -->
    <None Include="07-game.scene.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
