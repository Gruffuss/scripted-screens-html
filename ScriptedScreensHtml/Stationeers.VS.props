<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Import Project="$(MSBuildThisFileDirectory)Stationeers.VS.User.props" />
	<PropertyGroup>
		<TargetFramework Condition="'$(TargetFramework)' == ''">netstandard2.1</TargetFramework>
		<TargetFrameworkVersion Condition="'$(TargetFrameworkVersion)' == '' and '$(TargetFramework)' == 'net4.8'">v4.8</TargetFrameworkVersion>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<LangVersion>latest</LangVersion>
		<ErrorReport>none</ErrorReport>
		<LanguageTargets>$(MSBuildToolsPath)\Microsoft.CSharp.targets</LanguageTargets>
		<NoStandardLibraries>true</NoStandardLibraries>
		<NoStdLib>true</NoStdLib>
		<NoConfig>true</NoConfig>
		<DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Configurations>Debug;Release</Configurations>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>x64;x86</Platforms>
		<WarningLevel>4</WarningLevel>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);MSB3021;MSB3231;MSB3277</NoWarn>
		<StationeersDirectory>$(SteamLibraryDirectory)\Stationeers</StationeersDirectory>
		<StationeersDataDirectory>$(StationeersDirectory)\rocketstation_Data</StationeersDataDirectory>
		<StationeersManagedDirectory>$(StationeersDataDirectory)\Managed</StationeersManagedDirectory>
		<StationeersPluginsDirectory>$(StationeersDataDirectory)\Plugins</StationeersPluginsDirectory>
		<StationeersResourcesDirectory>$(StationeersDataDirectory)\Resources</StationeersResourcesDirectory>
		<StationeersStreamingAssetsDirectory>$(StationeersDataDirectory)\StreamingAssets</StationeersStreamingAssetsDirectory>
		<!-- Default assumes Documents is not redirected; override in User.props when it is (OneDrive, etc.). -->
		<StationeersDocumentsDirectory Condition="'$(StationeersDocumentsDirectory)' == ''">C:\Users\$(username)\Documents\My Games\Stationeers</StationeersDocumentsDirectory>
		<!-- Stationeers Steam app id and StationeersLua workshop item id (About.xml dependency); override in User.props if needed. -->
		<StationeersSteamAppId Condition="'$(StationeersSteamAppId)' == ''">544550</StationeersSteamAppId>
		<StationeersLuaWorkshopId Condition="'$(StationeersLuaWorkshopId)' == ''">3659911735</StationeersLuaWorkshopId>
		<!-- Same layout as Steam: steamapps\workshop\content\{appId}\{workshopItemId}\StationeersLua.dll (SteamLibraryDirectory is ...\steamapps\common). -->
		<_StationeersLuaWorkshopDll>$(SteamLibraryDirectory)\..\workshop\content\$(StationeersSteamAppId)\$(StationeersLuaWorkshopId)\StationeersLua.dll</_StationeersLuaWorkshopDll>
		<_StationeersLuaDocumentsDll>$(StationeersDocumentsDirectory)\mods\StationeersLua\StationeersLua.dll</_StationeersLuaDocumentsDll>
		<BIEDirectory>$(StationeersDirectory)\BepInEx</BIEDirectory>
		<BIECoreDirectory>$(BIEDirectory)\core</BIECoreDirectory>
		<BIEPatchersDirectory>$(BIEDirectory)\patchers</BIEPatchersDirectory>
		<BIEPluginsDirectory>$(BIEDirectory)\plugins</BIEPluginsDirectory>
		<StationeersLaunchPadDirectory>$(BIEPluginsDirectory)\StationeersLaunchPad</StationeersLaunchPadDirectory>
	</PropertyGroup>
	<!-- Auto path only when StationeersLuaAssemblyPath is unset in User.props: Documents mods first, Steam Workshop second. -->
	<Choose>
		<When Condition="'$(StationeersLuaAssemblyPath)' == '' and Exists('$(_StationeersLuaDocumentsDll)')">
			<PropertyGroup>
				<StationeersLuaAssemblyPath>$(_StationeersLuaDocumentsDll)</StationeersLuaAssemblyPath>
			</PropertyGroup>
		</When>
		<When Condition="'$(StationeersLuaAssemblyPath)' == '' and Exists('$(_StationeersLuaWorkshopDll)')">
			<PropertyGroup>
				<StationeersLuaAssemblyPath>$(_StationeersLuaWorkshopDll)</StationeersLuaAssemblyPath>
			</PropertyGroup>
		</When>
		<When Condition="'$(StationeersLuaAssemblyPath)' == ''">
			<PropertyGroup>
				<StationeersLuaAssemblyPath>$(_StationeersLuaDocumentsDll)</StationeersLuaAssemblyPath>
			</PropertyGroup>
		</When>
	</Choose>
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' != 'Debug'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>
	<ItemGroup>
		<CopyItemsGameData Include="$(ProjectDir)\GameData\**\*.*" />
		<CopyItemsAbout Include="$(ProjectDir)\About\**\*.*" />
		<CopyItemsAssets Include="$(ProjectDir)\Assets\**\*.*" />
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!-- Remove only what this build puts there. The whole-folder RemoveDir that stood here
		     deleted files added by hand to the deployed folder (a Preview.png, font files). It was
		     fixed in the template on 2026-09-17 and this local copy kept the old line; it only ever
		     failed because About is access-denied, and the day it succeeded it would wipe the folder. -->
		<ItemGroup>
			<_OwnedDeployFiles Include="$(StationeersDocumentsDirectory)\mods\$(ModName)\*.dll;$(StationeersDocumentsDirectory)\mods\$(ModName)\*.pdb;$(StationeersDocumentsDirectory)\mods\$(ModName)\*.md" />
		</ItemGroup>
		<Delete Files="@(_OwnedDeployFiles)" ContinueOnError="true" />
		<RemoveDir Directories="$(StationeersDocumentsDirectory)\mods\$(ModName)\examples" ContinueOnError="true" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StationeersDocumentsDirectory)\mods\$(ModName)" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" />
		<ItemGroup Condition="'$(Configuration)' == 'Debug'">
			<_ModDebugSymbols Include="$(TargetDir)*.pdb" />
		</ItemGroup>
		<Copy SourceFiles="@(_ModDebugSymbols)" DestinationFolder="$(StationeersDocumentsDirectory)\mods\$(ModName)" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" Condition="'$(Configuration)' == 'Debug' and '@(_ModDebugSymbols)' != ''" />
		<Copy SourceFiles="@(CopyItemsGameData)" DestinationFolder="$(StationeersDocumentsDirectory)\mods\$(ModName)\GameData\%(RecursiveDir)" ContinueOnError="true" />
		<Copy SourceFiles="@(CopyItemsAbout)" DestinationFolder="$(StationeersDocumentsDirectory)\mods\$(ModName)\About\%(RecursiveDir)" ContinueOnError="true" />
		<Copy SourceFiles="@(CopyItemsAssets)" DestinationFolder="$(StationeersDocumentsDirectory)\mods\$(ModName)\Assets\%(RecursiveDir)" ContinueOnError="true" />
	</Target>
	<ItemGroup>
		<Compile Remove="bin\**" />
		<Compile Remove="obj\**" />
		<EmbeddedResource Remove="bin\**" />
		<EmbeddedResource Remove="obj\**" />
		<None Remove="bin\**" />
		<None Remove="obj\**" />
	</ItemGroup>
</Project>
